{
  "name": "@10xdevs/draw",
  "version": "0.1.5",
  "type": "module",
  "description": "Create, render, and inspect Excalidraw drawings from the command line.",
  "bin": {
    "draw": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "dist/src",
    "fonts",
    "examples",
    ".agents/skills/diagram/SKILL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "setup": "npm run build",
    "draw": "node cli.mjs",
    "test": "npm run build && node --test dist/test/cli.test.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "fractional-indexing": "3.2.0",
    "perfect-freehand": "1.2.0",
    "roughjs": "4.6.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
